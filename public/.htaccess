Options -Indexes +SymLinksIfOwnerMatch
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Uncomment to force HTTPS once your SSL certificate is active
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never serve the app folder if it was uploaded inside the web root
  RewriteRule ^(app|cybercraft_app|database)(/|$) - [F,L]

  # Send everything that is not a real file to the front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Fallback when mod_rewrite is not available: send unknown URLs to index.php
<IfModule !mod_rewrite.c>
  <IfModule mod_dir.c>
    FallbackResource /index.php
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
